{
  "expo": {
    "name": "AlwaysOnVPN",
    "slug": "alwaysonvpn-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#07080c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alwaysonvpn.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07080c"
      },
      "package": "com.alwaysonvpn.mobile"
    },
    "web": {},
    "plugins": [
      "expo-asset",
      "./plugins/withOpenVpn"
    ]
  }
}
