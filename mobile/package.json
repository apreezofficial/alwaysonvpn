{
  "name": "alwaysonvpn-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "ts:check": "tsc --noEmit",
    "build:android:local": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "@react-navigation/native": "^6.1.10",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.0.0",
    "lucide-react-native": "^0.453.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "~5.6.3"
  },
  "private": true
}
